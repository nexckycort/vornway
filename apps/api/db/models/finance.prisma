enum FinanceAccountType {
  CASH
  BANK
  SAVINGS
  CREDIT_CARD
  TERM_DEPOSIT
  WALLET
  OTHER
}

enum FinanceAccountStatus {
  ACTIVE
  CLOSED
  MATURED
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
  BOTH
}

model FinanceAccount {
  id           String              @id @default(cuid())
  ownerId      String
  name         String
  accountType  FinanceAccountType  @default(CASH)
  institution  String?
  currency     String
  openingBalance Float             @default(0)
  currentBalance Float             @default(0)
  availableBalance Float           @default(0)
  lockedBalance Float              @default(0)
  creditLimit Float?
  usedCredit   Float               @default(0)
  interestRate Float?
  openedAt     DateTime?
  maturesAt    DateTime?
  status       FinanceAccountStatus @default(ACTIVE)
  notes        String?
  closedAt     DateTime?
  archivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  owner        User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  debtPayments DebtPayment[]
  expenses     Expense[]

  @@index([ownerId, archivedAt])
  @@index([ownerId, status, archivedAt])
  @@map("finance_account")
}

model FinanceCategory {
  id           String                   @id @default(cuid())
  ownerId      String
  name         String
  transactionType FinanceTransactionType
  icon         String?
  color        String?
  isDefault    Boolean                  @default(false)
  archivedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  owner        User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  budgets      FinanceBudget[]

  @@unique([ownerId, transactionType, name])
  @@index([ownerId, transactionType, archivedAt])
  @@map("finance_category")
}

model FinanceTransaction {
  id          String                  @id @default(cuid())
  ownerId     String
  accountId   String?
  categoryId  String?
  type        FinanceTransactionType
  amount      Float
  currency    String
  description String
  occurredAt  DateTime
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  owner       User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  account     FinanceAccount?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category    FinanceCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        FinanceTransactionTag[]

  @@index([ownerId, occurredAt(sort: Desc)])
  @@index([ownerId, type, occurredAt(sort: Desc)])
  @@index([categoryId, occurredAt(sort: Desc)])
  @@map("finance_transaction")
}

model FinanceTag {
  id           String                  @id @default(cuid())
  ownerId      String
  name         String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  owner        User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  transactions FinanceTransactionTag[]

  @@unique([ownerId, name])
  @@index([ownerId, name])
  @@map("finance_tag")
}

model FinanceTransactionTag {
  transactionId String
  tagId         String

  transaction   FinanceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag           FinanceTag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("finance_transaction_tag")
}

model FinanceBudget {
  id          String          @id @default(cuid())
  ownerId     String
  categoryId  String
  month       DateTime
  amount      Float
  currency    String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category    FinanceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([ownerId, categoryId, month, currency])
  @@index([ownerId, month])
  @@map("finance_budget")
}
