{
  "short_name": "Vornway",
  "name": "Vornway - Split Expenses",
  "description": "Split expenses, settle balances, and stay in sync. A modern way to manage shared expenses.",
  "start_url": "/",
  "display": "standalone",
  "id": "/",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "shortcuts": [
    {
      "name": "Create expense",
      "short_name": "New expense",
      "description": "Record a shared expense",
      "url": "/expenses/new?from=home&source=shortcut",
      "icons": [
        {
          "src": "/shortcuts/addexpense.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Create space",
      "short_name": "New space",
      "description": "Create a space to organize expenses",
      "url": "/groups/new?from=home&source=shortcut",
      "icons": [
        {
          "src": "/shortcuts/creategroup.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "background_color": "#fafafa",
  "theme_color": "#DE034D",
  "icons": [
    {
      "src": "/android/launchericon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android/launchericon-maskable-1254x1254.png",
      "sizes": "1254x1254",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/android/launchericon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/ios/180.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "orientation": "portrait",
  "scope": "/",
  "lang": "en",
  "screenshots": [
    {
      "src": "/screenshots/home.webp",
      "sizes": "892x1983",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Vornway home with expense and space summaries"
    },
    {
      "src": "/screenshots/group-details.webp",
