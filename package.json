{
  "name": "vornway",
  "private": true,
  "author": "Nestor Cortina <nexckycort@gmail.com>",
  "license": "MIT",
  "scripts": {
    "postinstall": "lefthook install",
    "clean:apps": "bun run -r --parallel --filter='./apps/*' clean",
    "clean:packages": "bun run -r --parallel --filter='./packages/*' clean",
    "clean": "bun run clean:apps & bun run clean:packages & rm -rf node_modules",
    "dev": "mprocs -c mprocs/dev.yaml",
    "portless:setup": "bash scripts/setup-portless.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:tooling",
    "@types/bun": "catalog:types",
    "@types/node": "catalog:types",
    "bun-types": "catalog:types",
    "lefthook": "^2.0.12",
    "mprocs": "^0.9.6",
    "typescript": "catalog:types"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "resend": "^6.12.2",
      "portless": "^0.15.5",
      "hono": "^4.12.33",
      "zod": "^4.3.6",
      "wrangler": "^4.115.0"
    },
    "catalogs": {
      "auth": {
        "better-auth": "^1.6.25"
      },
      "tooling": {
        "@biomejs/biome": "^2.5.4"
      },
      "ui": {
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0"
      },
      "prisma": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "prisma": "^7.8.0"
      },
      "types": {
        "@types/bun": "latest",
        "@types/node": "^24.13.3",
        "bun-types": "latest",
        "typescript": "^7.0.2"
      }
    }
  }
}
