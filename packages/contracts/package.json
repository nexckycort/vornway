{
  "name": "@vornway/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./src/api.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    },
    "./modules/*": {
      "types": "./src/modules/*.ts",
      "import": "./src/modules/*.ts"
    }
  },
  "scripts": {
    "fmt:fix": "bun fmt",
    "lint:fix": "bun lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "catalog:"
  },
  "peerDependencies": {
    "effect": "4.0.5"
  }
}
